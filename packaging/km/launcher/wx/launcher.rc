#include <winver.h>

KMSettingsIcon ICON "../launcher.ico"
1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION 1,1,1,0
PRODUCTVERSION 1,1,1,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Conglomera"
            VALUE "FileDescription", "Knight Mod Settings"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "InternalName", "KMSettings"
            VALUE "OriginalFilename", "KMSettings.exe"
            VALUE "ProductName", "Knight Mod Settings"
            VALUE "ProductVersion", "1.1.1.0"
            VALUE "Comments", "Source: https://github.com/Conglomera1/fheroes2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
